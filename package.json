{
  "name": "tchain-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @tchain/core build && pnpm --filter @tchain/web build && pnpm --filter tchain build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "tchain": "pnpm --filter tchain exec node dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "fast-check": "^4.1.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
